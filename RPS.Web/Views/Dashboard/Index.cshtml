@model RPS.Web.Models.ViewModels.PtDashboardVm
@using RPS.Web.Models.ViewModels;

@section styles {
    @Styles.Render("~/Content/dashboardcss")
    @Styles.Render("~/Content/activeissuescss")
}


<div class="dashboard-page page">

    <div class="container">
        <div class="row align-items-center justify-content-between">
            <div class="col-auto">
                <div class="frame13 d-flex flex-column align-items-start gap-2">
                    <div class="page-title">Dashboard</div>
                </div>
            </div>

            <div class="col-auto">
                <div class="Tools d-flex gap-3">
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group me-2">

                            @(Html.Kendo().ComboBoxFor(model => model.SelectedAssigneeId)
                                            .BindTo(Model.Assignees)
                                            .DataValueField("Id")
                                            .DataTextField("FullName")
                                            .Placeholder("Select assignee...")
                                            .HtmlAttributes(new { style="width: 260px;" })
                                            .Events(events =>
                                            {
                                                events.Change("onAssigneeChange");
                                            })
                                            .Template("<div class='row' style='margin-left: 5px;'>" + 
                                                        "<img src='" + Url.Content("~/Content/#:data.Avatar#") + "' class='li-avatar rounded mx-auto'" +
                                                        "<span style='margin-left:5px;'>#:data.FullName#</span></div>")
                            )

                        </div>
                        <div class="btn-group mr-2">

                            @(Html.Kendo().Button().Name("btnFilterMonths3")
                                .Content("3 Months")
                                .HtmlAttributes(new
                                {
                                    @class = ViewBag.months == 3 ? "k-selected" : ""
                                })
                                .Events(events =>
                                {
                                    events.Click("function() { onFilterItemClick(3) }");
                                })
                            )


                            @(Html.Kendo().Button().Name("btnFilterMonths6")
                                .Content("6 Months").Icon("calendar")
                                .HtmlAttributes(new
                                {
                                    @class = ViewBag.months == 6 ? "k-selected" : "",
                                    onclick = "location.href = '" + Html.Raw(Url.Action("Index", "Dashboard", new {months = 6, userId = ViewBag.userId})) + "';"
                                })
                            )
                            @(Html.Kendo().Button().Name("btnFilterMonths12")
                                .Content("1 Year").Icon("calendar")
                                .HtmlAttributes(new
                                {
                                    @class = ViewBag.months == 12 ? "k-selected" : "",
                                    onclick = "location.href = '" + Html.Raw(Url.Action("Index", "Dashboard", new {months = 12, userId = ViewBag.userId})) + "';"
                                })
                            )

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="container">

        @(Html.Kendo().TileLayout()
            .Name("tileLayout")
            .Columns(4)
            .Containers(c =>
            {
                c.Add().Header(h => h.Text("ACTIVE")).BodyTemplateId("tmplActiveIssues").ColSpan(1).RowSpan(1);
                c.Add().Header(h => h.Text("CLOSED")).BodyTemplateId("tmplClosedIssues").ColSpan(1).RowSpan(1);
                c.Add().Header(h => h.Text("OPEN")).BodyTemplateId("tmplOpenIssues").ColSpan(1).RowSpan(1);
                c.Add().Header(h => h.Text("CLOSE RATE")).BodyTemplateId("tmplCloseRate").ColSpan(1).RowSpan(1);
                c.Add().Header(h => h.Text("ALL ISSUES")).BodyTemplateId("tmplChart").ColSpan(4).RowSpan(1);
            })
            .Reorderable(true)
            .Resizable(true)
            .Events(e => e.Resize("onTileResize"))
        )

        <script id="tmplActiveIssues" type="text/x-kendo-template">
                <div class="numbers">
                    <div class="label-container">
                        <div class="base-input-label">
                            <div class="count-label color-default">
                                @(Model.StatusCounts.OpenItemsCount + Model.StatusCounts.ClosedItemsCount)
                            </div>
                        </div>
                    </div>
                    <div class="label-full-width">
                        <div class="base-input-label">
                            <div class="text-label color-default">
                                Active Issues
                            </div>
                        </div>
                    </div>
                </div>
        </script>

        <script id="tmplClosedIssues" type="text/x-kendo-template">
                <div class="numbers">
                    <div class="label-container">
                        <div class="base-input-label">
                            <div class="count-label color-closed">
                                @Model.StatusCounts.ClosedItemsCount
                            </div>
                        </div>
                    </div>
                    <div class="label-full-width">
                        <div class="base-input-label">
                            <div class="text-label color-closed">
                                Closed Issues
                            </div>
                        </div>
                    </div>
                </div>
        </script>

        <script id="tmplOpenIssues" type="text/x-kendo-template">
                <div class="numbers">
                    <div class="label-container">
                        <div class="base-input-label">
                            <div class="count-label color-open">
                                @Model.StatusCounts.OpenItemsCount
                            </div>
                        </div>
                    </div>
                    <div class="label-full-width">
                        <div class="base-input-label">
                            <div class="text-label color-open">
                                Open Issues
                            </div>
                        </div>
                    </div>
                </div>
        </script>

        <script id="tmplCloseRate" type="text/x-kendo-template">
                <div class="numbers">
                    <div class="close-rate-container">
                        <div class="label-container">
                            <div class="base-input-label">
                                <div class="count-label color-default">
                                    @Model.StatusCounts.ClosedItemsCount
                                </div>
                            </div>
                        </div>
                        <div class="label-full-width">
                            <div class="base-input-label">
                                <div class="text-label color-default">
                                    Close Rate
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
        </script>

        <script id="tmplChart" type="text/x-kendo-template">
            @Html.Partial("_DashboardChart", new PtDashboardChartVm(Model.FilteredIssues))
        </script>


    </div>
</div>

@section scripts {

    @{ 
        var userIdParam = "";
        var monthsParam = "";
        if (ViewBag.userId != null)
        {
            userIdParam = "&userId=" + ViewBag.userId;
        }
        if (ViewBag.months != null)
        {
            monthsParam = "months=" + ViewBag.months;
        }
    }


<script>
       function onAssigneeChange(e) {
           var userId = e.sender.value();
           if (userId) {
               location.href = `/?userId=${userId}&@Html.Raw(monthsParam)`;
           } else {
               location.href = `/?@Html.Raw(monthsParam)`;
           }
       }

       function onFilterItemClick(months) {
           location.href = `/?months=${months}@Html.Raw(userIdParam)`;
    }

    function onTileResize() {
        resizeChart('chart');
    }

    function resizeChart(chartId) {
        const chart = $('#' + chartId).data('kendoChart');
        chart.refresh();
    }



</script>
}

<script>
    $(document).ready(() => {
        resizeChart('chart');
    });
</script>