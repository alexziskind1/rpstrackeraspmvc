 @using RPS.Web.Models.Routing;
@using RPS.Web.Models.ViewModels;
@model RPS.Core.Models.PtItem

<div class="detail-page page">

    <div class="container">
        <div class="row align-items-center justify-content-between">
            <div class="col-auto">
                <div class="frame13 d-flex flex-column align-items-start gap-2">
                    <div class="page-title">
                        <span class="k-icon k-font-icon my-custom-icon-class"></span>
                        <style>
                            .my-custom-icon-class:before {
                                content: "\e646"; /* Adds a glyph using the Unicode character number */
                            }
                        </style>
                        @Model.Title
                    </div>
                </div>
            </div>
            <div class="col-auto">
                <div class="Tools d-flex gap-3">
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group mr-2">
                            @*<button class="btn btn-light" onclick="location.href = '@(Url.Action("Index", "Detail", new { id = Model.Id }))'">Form</button>
                            <button class="btn btn-light" onclick="location.href = '@(Url.Action("Tasks", "Detail", new { id = Model.Id }))'">Tasks</button>
                            <button class="btn btn-light" onclick="location.href = '@(Url.Action("Chitchat", "Detail", new { id = Model.Id }))'">Chitchat</button>*@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="container">
        <div style="margin-top: 20px">

            @(Html.Kendo().TabStrip()
                .Name("tabstrip")
                .Items(tabstrip =>
                {
                    tabstrip.Add()
                        .Text("Form")
                        .LinkHtmlAttributes(new { onclick = "pushUrl(\"RPS Project Tracker\", \"/Detail/" + Model.Id + "\")" })
                        .LoadContentFrom("DetailsForm", "Detail", Model.Id)
                        .Selected(ViewBag.screen == DetailScreenEnum.Form);

                    tabstrip.Add()
                        .Text("Tasks")
                        .LinkHtmlAttributes(new { onclick = "pushUrl(\"RPS Project Tracker\", \"/Detail/" + Model.Id + "/Tasks\")" })
                        .LoadContentFrom("TasksForm", "Detail", Model.Id)
                        .Selected(ViewBag.screen == DetailScreenEnum.Tasks);

                    tabstrip.Add()
                        .Text("Chitchat")
                        .LinkHtmlAttributes(new { onclick = "pushUrl(\"RPS Project Tracker\", \"/Detail/" + Model.Id + "/Chitchat\")" })
                        .LoadContentFrom("ChitchatForm", "Detail", Model.Id)
                        .Selected(ViewBag.screen == DetailScreenEnum.Chitchat);
                })
            )

            @*@{
                switch (ViewBag.screen)
                {
                    case DetailScreenEnum.Form:

                        @Html.Partial("_Form", new PtItemFormVm(Model, ViewBag.users));

                        break;
                    case DetailScreenEnum.Tasks:

                        @Html.Partial("_Tasks", new PtItemTasksVm(Model));

                        break;
                    case DetailScreenEnum.Chitchat:

                        @Html.Partial("_Chitchat", new PtItemCommentsVm(Model, ViewBag.currentUser));

                        break;
                }
            }*@

        </div>
    </div>


    @section styles {
        @Styles.Render("~/Content/detailcss")
        @Styles.Render("~/Content/chitchatcss")
    }

    @section scripts {
        @Html.Partial("_TasksScripts")

        <script>
            function pushUrl(title, url) {
                if ("undefined" !== typeof history.pushState) {
                    history.pushState(null, title, url);
                } else {
                    window.location.assign(url);
                }
            }
        </script>
    }

</div>