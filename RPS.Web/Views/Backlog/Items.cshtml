@using RPS.Web.Models.Routing;
@model IEnumerable<RPS.Core.Models.PtItem>


<div class="backlog-page page">
    <div class="container">
        <div class="row align-items-center justify-content-between">
            <div class="col-auto">
                <div class="frame13 d-flex flex-column align-items-start gap-2">
                    <div class="page-title">Backlog</div>
                </div>
            </div>
            <div class="col-auto">
                <div class="Tools d-flex gap-3">
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group mr-2">
                            <button class="btn btn-light" onclick="location.href = '@(Url.Action("Items", "Backlog", new { preset = "My" }))'">My Items</button>
                            <button class="btn btn-light" onclick="location.href = '@(Url.Action("Items", "Backlog", new { preset = "Open" }))'">Open Items</button>
                            <button class="btn btn-light" onclick="location.href = '@(Url.Action("Items", "Backlog", new { preset = "Closed" }))'">Done Items</button>
                        </div>

                        <div class="btn-group me-2">

                            @(Html.Kendo().Button().Name("btnAdd")
                                .Content("Add")
                                .Icon("plus-outline")
                                .HtmlAttributes(new { onclick = "location.href = '" + Url.Action("Create", "Backlog") + "'"})
                            )
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container" style="margin-top: 20px">

        @(Html.Kendo().Grid(Model).Name("grid")
            .DataSource(source =>
            {
                source.Server()
                    .PageSize(6)
                    .Model(m =>
                    {
                        m.Id(i => i.Id);
                    });
            })
            .RowAction(row =>
            {
                row.HtmlAttributes.Add("onclick", "location.href = '/Detail/" + row.DataItem.Id + "'");
            })
            .Columns(columns =>
            {
                columns.Bound(i => i.Type).Title(" ").Width(40)
                    .Template(i =>
                    {
                        return "<div class='pt-indicator' data-id='" + i.Id + "'>" + Rps.ItemTypeIndicatorImage(i.Type, "backlog-icon") + "</div>";
                    });

                columns.Bound(i => i.Assignee)
                    .Template(i =>
                    {
                        return Rps.UserAvatar(i.Assignee, null);
                    });

                columns.Bound(i => i.Title);

                columns.Bound(i => i.Priority)
                    .Template(i =>
                    {
                        return Rps.PriorityIndicator(i.Priority);
                    });

                columns.Bound(i => i.Estimate)
                    .Template(i =>
                    {
                        return "<span class='li-estimate'>" + i.Estimate + "</span>";
                    });

                columns.Bound(i => i.DateCreated).Title("Created")
                    .Template(i =>
                    {
                        return "<span class='li-date'>" + i.DateCreated.ToString("MMM d, yyyy") + "</span>";
                    });
            })
            .Pageable()
            .Sortable()
        )

        <div class="table-responsive">
            <table class="table table-striped table-sm table-hover">
                <thead>
                    <tr>
                        <th></th>
                        <th>Assignee</th>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Estimate</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="pt-table-row" onclick="location.href = '@(Url.Action("Index", "Detail", new { id = item.Id }))'">

                            <td>
                                @Rps.ItemTypeIndicatorImage(item.Type, "backlog-icon")
                            </td>
                            <td>
                                @Rps.UserAvatar(item.Assignee, null)
                            </td>
                            <td><span class="li-title">@Html.DisplayFor(modelItem => item.Title)</span></td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Status)
                            </td>
                            <td>
                                @Rps.PriorityIndicator(item.Priority)
                            </td>
                            <td><span class="li-estimate">@Html.DisplayFor(modelItem => item.Estimate)</span></td>
                            <td><span class="li-date">@item.DateCreated.ToString("MMM d, yyyy")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>


    @section styles {
        @Styles.Render("~/Content/backlogcss")
    }


@section scripts {
    
    <script>
        function onChange(arg) {
            var row = arg.sender.select()[0];

            var itemId = $($(row).find('.pt-indicator')[0]).attr('data-id');
            window.location.href = `/Detail/${itemId}/Form`;
        }
    </script>
    
}